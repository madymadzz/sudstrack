---
title: SudsTrack — Data Flow Diagram (Level 0 — Context Diagram)
---
flowchart LR
    CUSTOMER(["👤 Customer"])
    STAFF(["🧑‍💼 Staff / SuperAdmin"])
    GOOGLE_EXT(["🔑 Google OAuth"])
    SEMAPHORE(["📱 Semaphore SMS API"])
    OPENWEATHER(["🌦️ OpenWeatherMap API"])
    GOOGLEMAPS(["🗺️ Google Maps API"])
    QRSERVER(["📷 QRServer API"])
    EMAIL_SVC(["📧 Email / Gmail SMTP"])

    SUDSTRACK(["⚙️\nSudsTrack\nSystem"])

    %% Customer flows
    CUSTOMER -->|"Registration · Login\nBooking details · Pickup address\nPayment choice · Feedback\nProfile changes · 2FA setup"| SUDSTRACK
    SUDSTRACK -->|"Order confirmation · Order status\nSMS notification · Rider tracking\nNotifications · Weather warnings"| CUSTOMER

    %% Staff / Admin flows
    STAFF -->|"Login credentials · Order status updates\nCustomer management · Rider assignment\nPackage CRUD · Staff management\nPromotion management · Settings"| SUDSTRACK
    SUDSTRACK -->|"Dashboard stats · Order lists\nCustomer/staff lists · Audit logs\nSecurity logs · API logs\nAdmin notifications · Chat messages"| STAFF

    %% External APIs
    SUDSTRACK <-->|"OAuth token exchange\nUser profile data"| GOOGLE_EXT
    SUDSTRACK -->|"Contact number + SMS body"| SEMAPHORE
    SEMAPHORE -->|"Delivery status / error"| SUDSTRACK
    SUDSTRACK -->|"Pickup date + coordinates"| OPENWEATHER
    OPENWEATHER -->|"Forecast: rain warning, condition, icon"| SUDSTRACK
    SUDSTRACK -->|"Shop & delivery coordinates"| GOOGLEMAPS
    GOOGLEMAPS -->|"Route, distance, ETA, polyline"| SUDSTRACK
    SUDSTRACK -->|"Order code string"| QRSERVER
    QRSERVER -->|"QR code image URL"| SUDSTRACK
    SUDSTRACK -->|"Reset code + email address"| EMAIL_SVC
    EMAIL_SVC -->|"Delivery status"| SUDSTRACK
