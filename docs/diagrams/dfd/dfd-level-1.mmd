    STAFF -->|"Manage riders"| P4
    STAFF -->|"Manage customers/staff\nPackages / Promos / Settings"| P7
    STAFF -->|"Read notifications / Chat"| P6

    GOOGLE -->|"OAuth token + profile"| P1
    SMS_API -->|"SMS delivery status"| P8
    WEATHER_API -->|"Forecast JSON"| P8
    MAPS_API -->|"Route + ETA + polyline"| P8
    EMAIL_API -->|"Email delivery status"| P8

