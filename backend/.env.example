# ============================
# SERVER
# ============================
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://127.0.0.1:5500

# ============================
# DATABASE (Supabase PostgreSQL)
# ============================
# Get this from: Supabase Dashboard > Project Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres

# ============================
# JWT
# ============================
# Make this a long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_replace_this
JWT_EXPIRES_IN=7d

# ============================
# GOOGLE OAUTH
# ============================
# Get from: console.cloud.google.com > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ============================
# GOOGLE MAPS
# ============================
# Get from: console.cloud.google.com > APIs & Services > Credentials
# Enable: Maps JavaScript API + Directions API + Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ============================
# OPENWEATHERMAP
# ============================
# Get from: openweathermap.org > My API Keys (free account)
OPENWEATHER_API_KEY=your_openweathermap_api_key

# ============================
# SEMAPHORE SMS
# ============================
# Get from: semaphore.co > Dashboard > API Keys
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=SUDSTRACK

# ============================
# EMAIL (Gmail SMTP for password reset)
# ============================
# Use a Gmail account + generate an App Password
# Google Account > Security > 2-Step Verification > App Passwords
EMAIL_USER=your_gmail@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password
EMAIL_FROM_NAME=SudsTrack

# ============================
# QR CODE API
# ============================
# api.qrserver.com — free, no key needed
# Base URL is used in qrService.js directly
QR_API_BASE_URL=https://api.qrserver.com/v1/create-qr-code
